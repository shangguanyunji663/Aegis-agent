DATABASE_URL=sqlite:///data/aegis.sqlite
# MySQL 示例:DATABASE_URL=mysql+pymysql://root:密码@localhost:3306/aegis?charset=utf8mb4
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_PROVIDER=local
EMBEDDING_TIMEOUT_SECONDS=30
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
LLM_TIMEOUT_SECONDS=15
RISK_LLM_CHANNEL_ENABLED=true
LLM_THINKING_ENABLED=false

KNOWLEDGE_DIR=knowledge
MAX_KNOWLEDGE_UPLOAD_BYTES=1000000
KNOWLEDGE_TOP_K=4
KNOWLEDGE_CANDIDATE_K=16
KNOWLEDGE_CHUNK_SIZE=512
KNOWLEDGE_CHUNK_OVERLAP=64
KNOWLEDGE_HYBRID_VECTOR_WEIGHT=0.65
KNOWLEDGE_HYBRID_BM25_WEIGHT=0.35
KNOWLEDGE_RERANK_ENABLED=true
MEMORY_RECENT_MESSAGES=6
MEMORY_SUMMARY_MAX_CHARS=900

VECTOR_ENABLED=false
VECTOR_REQUIRED=false
VECTOR_BACKEND=chroma
CHROMA_DIR=data/chroma
CHROMA_HOST=
CHROMA_PORT=8000
CHROMA_COLLECTION_NAME=aegis_knowledge
CHROMA_SNAPSHOT_DIR=data/chroma-snapshots
CHROMA_SNAPSHOT_KEEP=5
VECTOR_TOP_K=16

REDIS_URL=
REDIS_LOCK_TIMEOUT_SECONDS=30
CHAT_RATE_LIMIT_PER_MINUTE=40

AGENT_RUNTIME=autonomous
AGENT_MAX_ROUNDS=8
AGENT_MAX_CLAIMS_PER_ROUND=4
AGENT_MAX_CLAIMS_PER_AGENT=3
AGENT_FINAL_ACCEPTANCE_MIN_CONFIDENCE=0.6

AUTH_SESSION_COOKIE=aegis_session
AUTH_SESSION_TTL_HOURS=24
AUTH_DEFAULT_ADMIN_USERNAME=admin
AUTH_DEFAULT_ADMIN_PASSWORD=admin123!
AUTH_DEFAULT_STUDENT_USERNAME=student
AUTH_DEFAULT_STUDENT_PASSWORD=student123!
AUTH_TEACHER_INVITE_CODE=aegis-teacher

SLOW_REQUEST_THRESHOLD_MS=800
SERVER_HOST=127.0.0.1
SERVER_PORT=8091
TOOL_BACKEND=internal
MCP_ENABLED=false
