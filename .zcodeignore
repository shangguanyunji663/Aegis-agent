# Local configuration and secrets
.env
.env.*
!.env.example
*.local

# Runtime state, local databases, generated application data
/data/
*.sqlite
*.sqlite-*
*.db
*.db-*

# Logs and temporary output
*.log
*.out
*.err
*.tmp
*.temp
*.swp
*.swo

# Build and packaging artifacts
build/
dist/
*.egg-info/
.eggs/

# Runtime-generated distilled skills; curated skills remain versioned.
skills/auto/

# Model weights and training artifacts (training lives outside this repo)
*.safetensors
*.safetensors.index.json
*.bin
*.pt
*.pth
*.ckpt
*.onnx
*.gguf
checkpoints/
exports/

# IDE, editor and local assistant state
.vscode/
.idea/
.vscode-test/
.zcode/
.mimosa/
.workbuddy/

# Operating-system files
.DS_Store
.DS_Store?
Thumbs.db
desktop.ini
$RECYCLE.BIN/

